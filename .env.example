# ──────────────────────────────────────────────────────
# Distributed Vulnerability Scan Orchestration Engine
# Environment Configuration Template
# ──────────────────────────────────────────────────────

# ── Application ──
APP_NAME=vulnscan-orchestrator
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vulnscan
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=vulnscan_dev_password
DATABASE_URL=postgresql+asyncpg://vulnscan:vulnscan_dev_password@postgres:5432/vulnscan

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Celery ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO / S3 ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_ARTIFACTS=scan-artifacts
MINIO_BUCKET_EVIDENCE=evidence
MINIO_USE_SSL=false

# ── JWT ──
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Agent Configuration ──
AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AGENT_HEARTBEAT_TIMEOUT_SECONDS=90
LOCK_DEFAULT_TTL_SECONDS=7200

# ── Scheduler ──
SCHEDULER_POLL_INTERVAL_SECONDS=5
SCHEDULER_MAX_CONCURRENT_JOBS=10

# ── Report Retention ──
REPORT_RETENTION_YEARS=3

# ── Frontend (Vite) ──
VITE_API_BASE_URL=http://localhost:8000/api/v1
