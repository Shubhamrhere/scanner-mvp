# Enforce LF line endings for text files, especially for Docker scripts
* text=auto eol=lf

# Explicitly set file types
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Windows specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite3 binary
