# Backend API Environment Variables (Example)
APP_ENV=development
APP_DEBUG=True
API_V1_PREFIX=/api/v1

# Security Secrets (Change in Production!)
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256

# Database
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=vulnscan_dev_password
POSTGRES_DB=vulnscan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vulnscan:vulnscan_dev_password@postgres:5432/vulnscan

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=False

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
